{
  "name": "video-convertor-for-iphone",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Web UI + API + Telegram webhook for shrinking iPhone videos, deployable on Vercel with any SQL database.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:connect": "tsx scripts/db-connect.ts",
    "worker": "tsx cli/worker.ts",
    "worker:status": "tsx cli/worker.ts --status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.1",
    "@vercel/functions": "^3.9.11",
    "dotenv": "^17.2.0",
    "kysely": "^0.29.0",
    "mysql2": "^3.11.0",
    "next": "15.5.27",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
