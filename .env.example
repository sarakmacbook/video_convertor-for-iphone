# Copy this file to .env and fill it in. Never commit .env.
#
# The file is shared by everything in this repository:
#   python -m video_convertor_bot   the Telegram bot (polling)
#   python -m worker                a converter worker for the web app
#   npm run dev / npm run build     the web UI + API + Telegram webhook
#   npm run worker                  the Node converter worker
#   npm run db:migrate              creates or updates the database schema
#
# Every value has a default, so an empty .env still boots. The Telegram bot needs BOT_TOKEN;
# the web app needs a database and a storage driver (or it will use SQLite + local files).

# ---------------------------------------------------------------- Telegram bot --------
# REQUIRED for the bot. Create a bot with @BotFather in Telegram and paste its token here.
BOT_TOKEN=

# Only for a local Telegram Bot API server (needed for videos over 20 MB, see README).
# TELEGRAM_API_URL=http://127.0.0.1:8081
# TELEGRAM_LOCAL_MODE=true

# Optional. Comma-separated Telegram user IDs allowed to use the bot and the web API. Empty means anyone.
# ALLOWED_USER_IDS=123456789

# Who sends the converted file back to Telegram when the web app receives the video:
#   server  this deployment sends it (default; works with the public Bot API)
#   worker  the worker that converted it sends it (needed with a local Bot API server)
#   off     no Telegram delivery, the file stays in the job history
# TELEGRAM_DELIVERY=server

# Quality. Lower CRF = closer to the original but bigger files. 18 to 22 is the useful range.
# CRF=20
# X265_PRESET=medium

# Limits and resources
# MAX_INPUT_MB=20
# MAX_CONCURRENT_JOBS=1
# FFMPEG_TIMEOUT_SECONDS=7200

# Only needed when ffmpeg / ffprobe are not on PATH
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe

# ------------------------------------------------------------- Web app (Vercel) -------
# One connection string, any of these databases. See docs/VERCEL.md for the exact URLs.
#   postgres://user:pass@host/db            Neon, Vercel Postgres, Supabase, RDS, self-hosted
#   mysql://user:pass@host/db               PlanetScale, Aiven, RDS, self-hosted
#   libsql://db-name.turso.io?authToken=…   Turso
#   file:./.data/app.db                     SQLite (local development, Docker, a mounted disk)
# DATABASE_URL=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Where uploaded originals and converted files live.
#   blob   Vercel Blob (default on Vercel; connect a store to the project)
#   s3     any S3-compatible service: AWS S3, Cloudflare R2, Supabase Storage, MinIO, Backblaze
#   local  this machine's disk (development, Docker)
# STORAGE_DRIVER=blob

# S3-compatible storage (only with STORAGE_DRIVER=s3)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true          # MinIO and some other services need this
# S3_PUBLIC_BASE_URL=               # only for a public bucket; normally leave empty

# Local storage (only with STORAGE_DRIVER=local)
# STORAGE_DIR=./.data/storage

# Protect the deployment. Without APP_PASSWORD anyone who knows the URL can upload videos and
# change settings — set it, or keep the deployment behind your own auth.
# APP_PASSWORD=
# APP_SECRET=                        # REQUIRED when APP_PASSWORD is set. Signs the session
#                                    # cookie. Any long random string, e.g. from `openssl rand -hex 32`.

# Shared secret between this deployment and converter workers (`npm run worker` /
# `python -m worker`). Workers can only claim jobs, download inputs and upload results.
# WORKER_SECRET=

# The public URL of this deployment, used to register the Telegram webhook when Vercel does not
# tell us (VERCEL_URL is used automatically on Vercel).
# APP_URL=https://your-app.vercel.app

# ffmpeg for the web app / Node worker. On Vercel there is no ffmpeg by default:
#   1. npm install ffmpeg-static        (downloaded at build time)
#   2. FFMPEG_URL=https://…/ffmpeg.tar.gz   (cached in /tmp for the life of the instance)
#   3. FFMPEG_PATH=/path/to/ffmpeg          (a binary baked into your own image)
# FFMPEG_PATH=
# FFPROBE_PATH=
# FFMPEG_URL=

# How long the cleanup cron keeps finished jobs (0 = forever). Also editable in the UI.
# JOB_RETENTION_DAYS=7

# Vercel sends `Authorization: Bearer <CRON_SECRET>` to /api/cron/cleanup once a day.
# CRON_SECRET=

# ------------------------------------------------------------ Conversion worker -------
# The worker converts jobs the deployment has queued. It needs the public URL of the app and
# the same WORKER_SECRET. On a self-hosted Bot API server set BOT_TOKEN here too, so the worker
# can fetch the video from Telegram and send the result back.
# APP_URL=https://your-app.vercel.app
# WORKER_NAME=mac-mini
# WORKER_CONCURRENCY=1
# WORKER_POLL_SECONDS=5

# Folder for temporary files (default: the system temp folder)
# WORK_DIR=

# DEBUG, INFO, WARNING or ERROR
# LOG_LEVEL=INFO
